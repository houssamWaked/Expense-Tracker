{
  "expo": {
    "name": "Pocketwise",
    "slug": "pocketwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.houssamwaked.pocketwise",
      "adaptiveIcon": {
        "backgroundColor": "#20231D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#D8F36A",
          "defaultChannel": "money-nudges"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#20231D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 148
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e4a39331-bc5a-4b79-a729-7490cd4153d6"
      }
    }
  }
}
